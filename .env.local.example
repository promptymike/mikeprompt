# Anthropic API (required)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (optional — enables auth + saved prompts)
# Get from: https://supabase.com → New Project → Settings → API
# Without these, the app runs fully offline (localStorage only)
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Upstash Redis (required for rate limiting)
# Get from: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://[your-db].upstash.io
UPSTASH_REDIS_REST_TOKEN=[your-token]

# Resend (email provider - required for registration emails)
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
